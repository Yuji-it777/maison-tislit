# ============================================================================
# Maison Tislit - DEMO environment variables (example only)
# Copy to .env and fill in with the DEMO project's values.
# The demo project is fully isolated from production - use ONLY its keys here.
# NEVER paste production keys into this file.
# ============================================================================

# --- Supabase (demo project) ---
VITE_SUPABASE_URL=https://YOUR-DEMO-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_DEMO_ANON_PUBLIC_KEY

# Used by the Supabase Edge Functions (create-payment-intent, submit-message)
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEMO_SERVICE_ROLE_KEY

# --- Stripe (TEST mode only) ---
# DEMO MODE: set this to "demo" (or omit it) to disable checkout entirely.
# The site will show "This is a demo environment — checkout is disabled"
# instead of calling Stripe. Cart, catalog, and admin stay fully functional.
VITE_STRIPE_PUBLISHABLE_KEY=demo
# For real payments use:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_DEMO_PUBLISHABLE_KEY

# Set as an edge function secret, NOT in .env. In demo mode, set it to "demo"
# (or leave it unset) and the edge function will also refuse PaymentIntents:
#   supabase functions secrets set STRIPE_SECRET_KEY=demo
#   supabase functions secrets set SUPABASE_SERVICE_ROLE_KEY=YOUR_DEMO_SERVICE_ROLE_KEY

# --- Cloudflare Turnstile (demo site key) ---
VITE_TURNSTILE_SITE_KEY=YOUR_DEMO_TURNSTILE_SITE_KEY

# --- EmailJS (optional - only if the demo uses contact forms) ---
VITE_EMAILJS_SERVICE_ID=YOUR_DEMO_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_DEMO_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_DEMO_EMAILJS_PUBLIC_KEY

# --- Admin account for the demo ---
# Sign up normally through the demo site, then promote via SQL:
#   UPDATE public.profiles SET is_admin = true WHERE email = 'demo-admin@example.com';
