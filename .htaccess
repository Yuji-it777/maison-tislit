# Maison Tislit — STRATO Hosting (Apache) configuration
# 301 redirects for unprefixed URLs, HTTPS enforcement, SPA fallback.
# Canonical URLs carry a trailing slash: mod_dir redirects slash-less
# directory requests BEFORE .htaccess rules run on STRATO (cannot be
# disabled from .htaccess), so prerender/sitemap/internal links all use
# the slashed form and these redirects target it directly (single hop).

RewriteEngine On

# --- HTTPS enforcement — global, runs before every other rule ---
# Covers every path including /en/shop, /en/*, and bare roots.
# Two conditions handle both native TLS and reverse-proxy/CDN setups.
RewriteCond %{HTTPS} off [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 200 rewrite: /en/shop (slashless) serves snapshot directly, no redirect ---
# Scoped to this route only. Placed before 301s so it wins for this exact path.
# NOTE: on STRATO mod_dir may still 301 slashless dirs before .htaccess runs;
# the Cloudflare Pages (_redirects) + Netlify rules above are the effective fix
# on the live host. Applies to all UAs including Googlebot.
RewriteRule ^en/shop$ /en/shop/index.html [L]

# --- 301s: unprefixed URLs -> default locale (server-side, passes link equity) ---
RewriteRule ^$ /en/ [R=301,L]
RewriteRule ^shop$ /en/shop/ [R=301,L]
# Unprefixed category pages -> default locale (slugs mirror src/config/categories.ts)
RewriteRule ^shop/(djellaba|gandoura|caftan)/?$ /en/shop/$1/ [R=301,L]
# Removed category collections: takchita + jabador -> closest surviving collection
RewriteRule ^(en|nl)/shop/takchita/?$ /$1/shop/caftan/ [R=301,L]
RewriteRule ^(en|nl)/shop/jabador/?$ /$1/shop/djellaba/ [R=301,L]
RewriteRule ^product/([^/]+)/?$ /en/product/$1/ [R=301,L]
RewriteRule ^about$ /en/about/ [R=301,L]
RewriteRule ^contact$ /en/contact/ [R=301,L]
RewriteRule ^cart$ /en/cart/ [R=301,L]
RewriteRule ^login$ /en/login/ [R=301,L]
RewriteRule ^checkout$ /en/checkout/ [R=301,L]
RewriteRule ^confirmation$ /en/confirmation/ [R=301,L]
RewriteRule ^account$ /en/account/ [R=301,L]
RewriteRule ^shipping$ /en/shipping/ [R=301,L]
RewriteRule ^returns$ /en/returns/ [R=301,L]

# --- 301s: removed "-2" duplicate product pages -> real counterparts ---
# Rows were deleted from the DB (migration 00022); keep old links working
# for visitors and Google. Exact slugs only, both locales.
RewriteRule ^(en|nl)/product/(emerald-royal-djellaba|blue-safira-djellaba|nour-al-qamar-takchita|enchanted-rosa-takchita|bordeaux-sultana-gandoura|white-jasmine-gandoura|embroidered-royal-caftan|fassi-takchita|silk-jabador|golden-belt)-2/?$ /$1/product/$2/ [R=301,L]

# --- 301s: renamed product slugs (migrations 00026 + dashboard renames) ---
# Takchita/jabador products were recategorized and renamed; gandouras were
# renamed again from the dashboard (00027 images). Chain covers every era:
# original seed slugs -> current slugs. Keep old product links (and sitemap
# history) working for visitors and Google.
RewriteRule ^(en|nl)/product/nour-al-qamar-takchita/?$ /$1/product/nour-al-qamar-caftan/ [R=301,L]
RewriteRule ^(en|nl)/product/enchanted-rosa-takchita/?$ /$1/product/enchanted-rosa-caftan/ [R=301,L]
RewriteRule ^(en|nl)/product/fassi-takchita/?$ /$1/product/fassi-caftan/ [R=301,L]
RewriteRule ^(en|nl)/product/silk-jabador/?$ /$1/product/silk-gandoura/ [R=301,L]
RewriteRule ^(en|nl)/product/bordeaux-sultana-gandoura/?$ /$1/product/royal-sand-gandoura/ [R=301,L]
RewriteRule ^(en|nl)/product/white-jasmine-gandoura/?$ /$1/product/terracotta-satin-gandoura/ [R=301,L]
RewriteRule ^(en|nl)/product/silk-gandoura/?$ /$1/product/majorelle-blue-gandoura/ [R=301,L]

# --- SPA fallback: only reached when no static file/dir exists at the path ---
# (prerendered dist/en/... snapshots exist on disk, so they win naturally)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]