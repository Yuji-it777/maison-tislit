# STRATO SFTP deployment config — copy to deploy.env and fill in (deploy.env is gitignored)
# Get these from your STRATO Hosting Basic FTP/SFTP account details.

# SFTP host for STRATO shared hosting (check your STRATO panel; often sftp.strato.de)
STRATO_HOST=sftp.strato.de
STRATO_PORT=22

# FTP/SFTP username (often like u123456@u123456.strato.de)
STRATO_USER=your-username

# Password (or use STRATO_KEY_PATH for SSH key auth instead — comment out the other)
STRATO_PASS=your-password
# STRATO_KEY_PATH=C:\path\to\private_key

# Web root folder on the server (STRATO Hosting Basic default is "html")
STRATO_REMOTE_DIR=html